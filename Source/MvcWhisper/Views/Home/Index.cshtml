@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

div class="audio-prompt-container">
    <button id="recordBtn" class="btn btn-primary">🎤 Aufnahme starten</button>
    <div id="status" class="mt-2 text-muted">Bereit...</div>
    <div id="result" class="mt-3 font-weight-bold"></div>
</div>

<script>
    let mediaRecorder;
    let audioChunks = [];
    const recordBtn = document.getElementById('recordBtn');
    const statusDiv = document.getElementById('status');
    const resultDiv = document.getElementById('result');

    recordBtn.addEventListener('click', async () => {
        // Wenn bereits aufgenommen wird: Stoppen und senden
        if (mediaRecorder && mediaRecorder.state === "recording") {
            mediaRecorder.stop();
            recordBtn.textContent = "🎤 Aufnahme starten";
            statusDiv.textContent = "Verarbeite Audio...";
            return;
        }

        // Neue Aufnahme starten
        audioChunks = [];
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            
            // Nutzen Sie das Standard-Browser-Format (meist audio/webm oder audio/ogg)
            mediaRecorder = new MediaRecorder(stream);
            
            mediaRecorder.ondataavailable = (event) => {
                if (event.data.size > 0) {
                    audioChunks.push(event.data);
                }
            };

            mediaRecorder.onstop = async () => {
                // Alle Chunks zu einem Blob zusammenführen
                const audioBlob = new Blob(audioChunks, { type: mediaRecorder.mimeType });
                
                // Formulardaten für die API vorbereiten
                const formData = new FormData();
                formData.append("audioFile", audioBlob, "live-prompt.webm");

                // Per POST an die ASP.NET Core API senden
                try {
                    const response = await fetch('/api/audio/live-prompt', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        resultDiv.innerHTML = `<strong>Erkannter Prompt:</strong> "${data.prompt}"`;
                        statusDiv.textContent = "Erfolgreich verarbeitet.";
                    } else {
                        statusDiv.textContent = "Fehler bei der Verarbeitung auf dem Server.";
                    }
                } catch (err) {
                    statusDiv.textContent = "Netzwerkfehler beim Senden.";
                    console.error(err);
                }
            };

            // Aufnahme starten
            mediaRecorder.start();
            recordBtn.textContent = "🛑 Aufnahme stoppen";
            statusDiv.textContent = "Aufnahme läuft... Sprechen Sie jetzt.";

        } catch (err) {
            statusDiv.textContent = "Mikrofon-Zugriff verweigert oder nicht unterstützt.";
            console.error(err);
        }
    });
</script>
